# ============================================================
# Pion - .gitignore
# ============================================================

# ---- Python - byte-compiled / optimized / DLL --------------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Distributon / paketim ---------------------------------
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# ---- Teste / mbulimi i kodit --------------------------------
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# ---- Përkthime ----------------------------------------------
*.mo
*.pot

# ---- Django -------------------------------------------------
*.log
logs/
local_settings.py
db.sqlite3
db.sqlite3-journal
*.sqlite3

# Flask / Scrapy / Sphinx (jogenerike)
instance/
.webassets-cache
.scrapy
docs/_build/

# PyBuilder
target/

# Jupyter
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath
*.sage.py

# ---- Mjedise virtuale ---------------------------------------
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder / Rope
.spyderproject
.spyproject
.ropeproject

# mkdocs
/site

# mypy / Pyre
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ---- Sekrete & certifikata lokale ---------------------------
# Çelësat dhe certifikatat lokale të zhvillimit nuk duhen
# asnjëherë në version control
certs/
*.key
*.pem
*.p12
*.pfx

# ---- IDEs ----------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS -------------------------------------------------------
.DS_Store
Thumbs.db
._*

# ---- Django specifike ----------------------------------------
# Skedarët e ngarkuar nga përdoruesit dhe statika e mbledhur
media/
staticfiles/

# ---- Skedarë të tjerë të përkohshëm ---------------------------
core.*
*.pid
*.seed
*.bak
*.orig
