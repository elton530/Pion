# Pion Platform - Environment Configuration
# 
# IMPORTANT: For production, copy this to .env and update all values
# NEVER commit .env file to version control!
#
# Development vs Production:
# - Set DEBUG=False for production
# - Update SECRET_KEY (use 50+ character random string)
# - Configure actual database connection
# - Set up email with real SMTP credentials
# - Configure SSL/TLS

# ==================== DJANGO CORE ====================

# Security: Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-CHANGE-THIS-TO-RANDOM-50-CHAR-STRING-FOR-PRODUCTION

# Set to False for production
DEBUG=True

# Comma-separated list of allowed hosts for production
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com,www.yourdomain.com


# ==================== DATABASE CONFIGURATION ====================

# PostgreSQL Connection
DATABASE_URL=postgres://elton:password@localhost:5432/tour_platform
DB_NAME=tour_platform
DB_USER=elton
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# For production, use environment-specific connection:
# DB_HOST=db.your-hosting-provider.com
# DB_USER=prod_user
# DB_PASSWORD=strong-random-password-here


# ==================== EMAIL CONFIGURATION ====================

# For production, uncomment and configure these settings
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-specific-password-not-regular-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@openmap.al

# Current development setting (prints emails to console)
# Comment this out in production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend


# ==================== PAYMENT PROCESSING ====================

# Stripe API keys from https://dashboard.stripe.com
# Get these from your Stripe dashboard
STRIPE_PUBLIC_KEY=pk_live_your_public_key_here
STRIPE_SECRET_KEY=sk_live_your_secret_key_here

# For testing use:
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...


# ==================== CORS & SECURITY ====================

# For production, update these to your actual domains
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com,https://www.yourdomain.com

# Security settings (only active when DEBUG=False)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True


# ==================== CACHING (Optional but Recommended) ====================

# Redis for caching and sessions
REDIS_URL=redis://127.0.0.1:6379/0

# For production on hosted Redis:
# REDIS_URL=redis://user:password@redis.provider.com:6379/0


# ==================== LOGGING (Production) ====================

# Sentry error tracking (optional)
# Get your DSN from https://sentry.io
# SENTRY_DSN=https://key@sentry.io/project-id

# Admin email for error notifications
ADMIN_EMAIL=admin@openmap.al


# ==================== DEVELOPMENT TOOLS ====================

# Uncomment for local development debugging
# DEBUG_TOOLBAR=True
