# Pion Platform - Environment Configuration
#
# Copy this file to .env and adjust values for your environment.
# NEVER commit the .env file to version control (.env is in .gitignore).
#
# ============================================================
# Environment selection
# ============================================================
# Development is the DEFAULT mode. If ENVIRONMENT is unset (or set to
# anything other than "production"), the app runs with development settings
# (DEBUG=True, console email, plain static storage, no HTTPS enforcement).
#
# To run in production mode, set ENVIRONMENT=production (or export
# DJANGO_ENV=production) -> DEBUG=False plus hardened security.
#
#   ENVIRONMENT=development   -> DEBUG=True   (default)
#   ENVIRONMENT=production    -> DEBUG=False
# ============================================================


# ==================== DJANGO CORE ====================

# Required in production. If omitted while running in development mode, the
# app falls back to a dev-only placeholder key.
# Use a random value of 50+ characters. Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# development | production
ENVIRONMENT=development

# Comma-separated list of allowed hosts.
# Development: 127.0.0.1,localhost (plus your LAN IP if you test on devices)
# Production:  yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of CSRF-trusted origins.
# Development: http://127.0.0.1:8000,http://localhost:8000
# Production:  https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000


# ==================== DATABASE CONFIGURATION ====================

# PostgreSQL connection (used by settings and docker-entrypoint.sh)
# DB_USER and DB_PASSWORD are REQUIRED (settings fail fast if missing).
DB_NAME=tour_platform
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# For production, use environment-specific connection:
# DB_HOST=db.your-hosting-provider.com
# DB_USER=prod_user
# DB_PASSWORD=strong-random-password-here


# ==================== EMAIL CONFIGURATION ====================

# Development: if EMAIL_BACKEND is left empty the console backend is used
# (emails are printed to stdout, nothing is sent). Brevo credentials are NOT
# required locally.
#
# Production: SMTP backend with real credentials (Brevo).
# Leave EMAIL_BACKEND empty for the SMTP default in production.
EMAIL_BACKEND=

# Brevo SMTP (production only)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-brevo-smtp-login
EMAIL_HOST_PASSWORD=your-brevo-smtp-password
DEFAULT_FROM_EMAIL=noreply@openmap.al


# ==================== PAYMENT PROCESSING ====================

# Stripe API keys from https://dashboard.stripe.com
# For testing use:
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_live_your_public_key_here
STRIPE_SECRET_KEY=sk_live_your_secret_key_here


# ==================== CORS ====================

# Comma-separated list of allowed origins.
# Development: http://localhost:3000,http://127.0.0.1:3000
# Production:  https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ==================== PRODUCTION SECURITY (only read when ENVIRONMENT=production) ====================

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True


# ==================== AUTH RATE LIMITING ====================

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
